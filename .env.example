APP_NAME=CivicPulse
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=civicpulse
DB_USERNAME=root
DB_PASSWORD=

DB_PGSQL_HOST=127.0.0.1
DB_PGSQL_PORT=5432
DB_PGSQL_DATABASE=civicpulse
DB_PGSQL_USERNAME=postgres
DB_PGSQL_PASSWORD=
DB_PGSQL_SSLMODE=

DB_SQLITE_DATABASE=database/civicpulse.sqlite
# Session configuration
SESSION_ENABLED=true
SESSION_COOKIE_NAME=CIVICPULSE_SESSION
SESSION_COOKIE_LIFETIME=0
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=auto
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
